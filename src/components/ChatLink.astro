---
import ArrowIcon from '@/components/ArrowIcon.astro';

interface Props {
  href: string;
  label?: string;
  /** Botão preenchido (usado no pacote em destaque). */
  fill?: boolean;
}

const { href, label = 'Conversar', fill = false } = Astro.props;
---

<a href={href} target="_blank" rel="noopener" class:list={['btn', fill && 'btn-fill']} style={fill ? '--fill: #fda8cf' : undefined}>
  {label} <ArrowIcon />
</a>
