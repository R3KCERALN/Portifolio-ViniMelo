---
import { Image } from 'astro:assets';
import ProcessSteps from '@/components/process/ProcessSteps.tsx';
import TimelapseDialog from '@/components/process/TimelapseDialog.astro';
import timeline from '@/assets/processo-timeline.jpg';
import { site } from '@/data/site';

// O primeiro parágrafo da spec; o segundo ("Cada bloco passa pelas mesmas etapas:") sai porque as etapas já estão acima.
const [intro] = site.processIntro.split('\n\n');
---

<section id="processo" class="page py-14 md:py-20" style="--accent: var(--green)">
  <div class="grid gap-12 md:grid-cols-2 md:gap-16">
    <div>
      <p class="eyebrow">{site.processEyebrow}</p>
      <h2 class="display mt-2">Processo<br />criativo.</h2>
      <p class="subtitle mt-3">{site.processTagline}</p>
      <ProcessSteps client:visible steps={[...site.processStepLabels]} />
    </div>

    <div>
      <div class="corners px-6 pt-6 pb-6 md:px-8">
        <Image
          src={timeline}
          alt="Timeline de edição de um vídeo do Vinicius"
          width={800}
          widths={[480, 640, 800]}
          sizes="(min-width: 768px) 40rem, 90vw"
          class="aspect-[4/3] w-full object-cover object-[50%_47%]"
        />
        <span class="corner-b"></span>
      </div>
      <TimelapseDialog />
    </div>
  </div>

  <div class="mt-12 max-w-[65ch] space-y-4 text-[1.0625rem] leading-relaxed text-dim">
    <p>{intro}</p>
    <p>{site.processReferences}</p>
  </div>
</section>
