---
import PortfolioCarousel, { type CarouselVideo } from '@/components/portfolio/PortfolioCarousel.tsx';
import ArrowIcon from '@/components/ArrowIcon.astro';
import { site } from '@/data/site';

interface Props {
  videos: CarouselVideo[];
}

const { videos } = Astro.props;
---

<section id="portfolio" class="page py-14 md:py-20" style="--accent: var(--blue)">
  <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="eyebrow">{site.portfolioEyebrow}</p>
      <h2 class="display mt-2">Portfólio.</h2>
      <p class="subtitle mt-3">{site.portfolioTagline}</p>
    </div>
    <a href={site.driveFolderUrl} target="_blank" rel="noopener" class="btn self-start md:mb-1 md:self-auto">
      Ver todos os trabalhos <ArrowIcon />
    </a>
  </div>
  <PortfolioCarousel client:visible videos={videos} />
</section>
