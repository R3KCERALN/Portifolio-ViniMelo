---
import ArrowIcon from '@/components/ArrowIcon.astro';
import ChatLink from '@/components/ChatLink.astro';
import { site } from '@/data/site';
import {
  customContractMessage,
  packDiscountPercent,
  packPricePerVideo,
  packs,
  tiers,
} from '@/data/pricing';
import { formatBRL } from '@/lib/format';
import { whatsappUrl } from '@/lib/whatsapp';

const tierName = (id: string) => tiers.find((t) => t.id === id)!.name.toLowerCase();
const packContents = (items: { tierId: string; quantity: number }[]) =>
  items.length === 1
    ? `${items[0].quantity} vídeos ${tierName(items[0].tierId)}s`
    : items.map((i) => `${i.quantity} ${tierName(i.tierId)}s`).join(' + ');
---

<section id="contrate" class="page py-14 md:py-20" style="--accent: var(--pink)">
  <p class="eyebrow">{site.hireEyebrow}</p>
  <h2 class="display mt-2">Contrate o Vinicius.</h2>
  <p class="subtitle mt-3 max-w-[60ch]">{site.hireTagline}</p>
  <p class="mt-4 max-w-[65ch] text-[1.0625rem] leading-relaxed text-dim">{site.hireIntro}</p>

  <h3 class="mt-12 text-2xl font-bold text-cream">Vídeos avulsos</h3>
  <ul role="list" class="mt-3 border-y border-rule-strong">
    {
      tiers.map((tier) => (
        <li class="grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-1 border-b border-rule py-4 last:border-b-0 md:grid-cols-[minmax(9rem,1fr)_minmax(0,2.2fr)_minmax(8rem,0.9fr)_auto] md:gap-x-0 md:py-3">
          <h4 class="text-xl font-bold text-cream md:px-4 md:text-[1.375rem]">{tier.name}</h4>
          <p class="tabular relative text-right text-xl font-bold text-cream md:order-3 md:px-6 md:text-left md:text-[1.25rem] md:before:absolute md:before:top-1/2 md:before:left-0 md:before:h-5 md:before:w-px md:before:-translate-y-1/2 md:before:bg-rule-strong">
            <span class="block">{tier.price === null ? 'Sob consulta' : formatBRL(tier.price)}</span>
            {tier.priceNote && <span class="mt-0.5 block text-sm font-normal text-dim">{tier.priceNote}</span>}
          </p>
          <div class="relative col-span-2 md:order-2 md:col-span-1 md:px-6 md:before:absolute md:before:top-1/2 md:before:left-0 md:before:h-5 md:before:w-px md:before:-translate-y-1/2 md:before:bg-rule-strong">
            <p class="text-[1.0625rem] text-body">{tier.shortDescription}</p>
            <p class="mt-0.5 text-sm leading-snug text-dim">{tier.description}</p>
          </div>
          <a
            href={whatsappUrl(tier.whatsappMessage)}
            target="_blank"
            rel="noopener"
            aria-label={`Conversar sobre o ${tier.name}`}
            class="btn !size-11 !min-h-0 !p-0 max-md:col-start-1 max-md:row-start-4 max-md:mt-3 max-md:!w-full md:order-4 md:mr-1"
          >
            <ArrowIcon dir="right" size={20} />
          </a>
        </li>
      ))
    }
  </ul>
  <p class="mt-4 max-w-[65ch] text-[1.0625rem] leading-relaxed text-dim">
    O preço depende da duração, de onde o vídeo será postado (Reels, Shorts, vídeo longo para YouTube, criativo para tráfego) e da quantidade de informação e efeitos. Só os níveis Básico e Intermediário têm preço fixo, e só para Reels/TikTok de até 1 minuto.
  </p>

  <h3 class="mt-12 text-2xl font-bold text-cream">Pacotes</h3>
  <div class="mt-4 grid gap-6 md:grid-cols-2">
    {
      packs.map((pack) => (
        <div class:list={['flex flex-col rounded-md border-[1.5px] p-6 md:p-8', pack.highlighted ? 'border-pink' : 'border-cream']}>
          {pack.highlighted && <p class="eyebrow !text-[0.8125rem]" style="--accent: var(--pink)">Mais vantajoso</p>}
          <h4 class="text-3xl font-bold text-cream">{pack.name}</h4>
          <p class="mt-1 text-body">{packContents(pack.items)}</p>
          <p class="tabular mt-4 text-[clamp(2.75rem,4.4vw,3.75rem)] leading-none font-black tracking-[-0.04em] text-cream">{formatBRL(pack.price)}</p>
          <p class="tabular mt-4 text-body">
            {formatBRL(packPricePerVideo(pack))} por vídeo · {packDiscountPercent(pack)}% de desconto
          </p>
          <p class="text-body">Válido por {pack.validityDays} dias</p>
          <div class="mt-6">
            <ChatLink href={whatsappUrl(pack.whatsappMessage)} fill={pack.highlighted} />
          </div>
        </div>
      ))
    }
  </div>

  <p class="mt-8">
    <a href={whatsappUrl(customContractMessage)} target="_blank" rel="noopener" class="text-[1.125rem] text-body underline-offset-4 hover:underline">
      <strong class="font-bold text-cream">{site.customContractLead}</strong> {site.customContractRest}
    </a>
  </p>
  <p class="mt-2 max-w-[65ch] text-sm leading-relaxed text-dim">{site.customContractText}</p>
  <p class="mt-1 text-sm text-dim">{site.invoiceNote}</p>
</section>
