---
import { FileText } from 'lucide-react';
import ChatLink from '@/components/ChatLink.astro';
import { Badge } from '@/components/ui/badge';
import { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from '@/components/ui/card';
import { site } from '@/data/site';
import {
  customContractMessage,
  packDiscountPercent,
  packFullPrice,
  packPricePerVideo,
  packs,
  tiers,
} from '@/data/pricing';
import { formatBRL } from '@/lib/format';
import { whatsappUrl } from '@/lib/whatsapp';

const tierName = (id: string) => tiers.find((t) => t.id === id)!.name.toLowerCase();
const packContents = (items: { tierId: string; quantity: number }[]) =>
  items.length === 1
    ? `${items[0].quantity} vídeos ${tierName(items[0].tierId)}s`
    : items.map((i) => `${i.quantity} ${tierName(i.tierId)}s`).join(' + ');
---

<section id="contrate" class="mx-auto w-full max-w-5xl scroll-mt-4 px-4 py-20 md:px-8">
  <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">Contrate o Vinicius</h2>
  <p class="mt-6 max-w-2xl leading-relaxed text-foreground/90">{site.hireIntro}</p>

  <h3 class="mt-14 text-xl font-semibold">Vídeo avulso</h3>
  <p class="mt-3 max-w-2xl leading-relaxed text-foreground/90">
    O preço depende da duração, de onde o vídeo será postado (Reels, Shorts, vídeo longo para YouTube, criativo para tráfego) e da quantidade de informação e efeitos. Só os níveis Básico e Intermediário têm preço fixo, e só para Reels/TikTok de até 1 minuto.
  </p>
  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      tiers.map((tier) => (
        <Card className="bg-card">
          <CardHeader>
            <CardTitle className="text-base">{tier.name}</CardTitle>
            <CardDescription>{tier.description}</CardDescription>
          </CardHeader>
          <CardContent className="mt-auto">
            <p class="text-2xl font-semibold">{tier.price === null ? 'Sob consulta' : formatBRL(tier.price)}</p>
            {tier.priceNote && <p class="mt-1 text-sm text-muted-foreground">{tier.priceNote}</p>}
          </CardContent>
          <CardFooter>
            <ChatLink href={whatsappUrl(tier.whatsappMessage)} />
          </CardFooter>
        </Card>
      ))
    }
  </div>

  <h3 class="mt-14 text-xl font-semibold">Pacotes</h3>
  <div class="mt-6 grid gap-4 md:grid-cols-2">
    {
      packs.map((pack) => (
        <Card className={pack.highlighted ? 'bg-card ring-2 ring-primary' : 'bg-card'}>
          <CardHeader>
            <div class="flex items-center justify-between gap-3">
              <CardTitle className="text-base">{`Pacote ${pack.name}`}</CardTitle>
              {pack.highlighted && <Badge className="bg-primary text-primary-foreground">Mais vantajoso</Badge>}
            </div>
            <CardDescription>{packContents(pack.items)}</CardDescription>
          </CardHeader>
          <CardContent className="mt-auto space-y-1">
            <p class="text-3xl font-semibold">{formatBRL(pack.price)}</p>
            <p class="text-sm text-foreground/90">
              {formatBRL(packPricePerVideo(pack))} por vídeo · {packDiscountPercent(pack)}% de desconto
            </p>
            <p class="text-sm text-muted-foreground">
              <span class="line-through">{formatBRL(packFullPrice(pack))}</span> · Válido por {pack.validityDays} dias
            </p>
          </CardContent>
          <CardFooter>
            <ChatLink href={whatsappUrl(pack.whatsappMessage)} />
          </CardFooter>
        </Card>
      ))
    }
  </div>

  <Card className="mt-4 bg-card">
    <CardHeader>
      <CardTitle className="text-base">Contrato personalizado</CardTitle>
      <CardDescription>{site.customContractText}</CardDescription>
    </CardHeader>
    <CardFooter>
      <ChatLink href={whatsappUrl(customContractMessage)} />
    </CardFooter>
  </Card>

  <p class="mt-8 flex items-center gap-2 text-sm text-foreground/90">
    <FileText size={18} strokeWidth={1.75} aria-hidden="true" className="shrink-0 text-muted-foreground" />
    {site.invoiceNote}
  </p>
</section>
