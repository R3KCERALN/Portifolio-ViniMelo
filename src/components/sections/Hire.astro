---
import { FileText } from 'lucide-react';
import ChatLink from '@/components/ChatLink.astro';
import { site } from '@/data/site';
import {
  customContractMessage,
  packDiscountPercent,
  packFullPrice,
  packPricePerVideo,
  packs,
  tiers,
} from '@/data/pricing';
import { formatBRL } from '@/lib/format';
import { whatsappUrl } from '@/lib/whatsapp';

const tierName = (id: string) => tiers.find((t) => t.id === id)!.name.toLowerCase();
const packContents = (items: { tierId: string; quantity: number }[]) =>
  items.length === 1
    ? `${items[0].quantity} vídeos ${tierName(items[0].tierId)}s`
    : items.map((i) => `${i.quantity} ${tierName(i.tierId)}s`).join(' + ');
---

<section id="contrate" class="mx-auto w-full max-w-[80rem] scroll-mt-4 px-4 py-16 md:px-8 lg:py-24">
  <h2 class="display section-mark" style="--mark: #e8a0bf">Contrate o Vinicius</h2>
  <p class="prose-block mt-8 text-foreground">{site.hireIntro}</p>

  <h3 class="mt-16 text-xl font-bold">Vídeo avulso</h3>
  <p class="prose-block mt-3 text-foreground">
    O preço depende da duração, de onde o vídeo será postado (Reels, Shorts, vídeo longo para YouTube, criativo para tráfego) e da quantidade de informação e efeitos. Só os níveis Básico e Intermediário têm preço fixo, e só para Reels/TikTok de até 1 minuto.
  </p>
  <ul role="list" class="mt-6 divide-y divide-[#111] rounded-[2px] bg-[#232323]">
    {
      tiers.map((tier) => (
        <li class="grid gap-x-8 gap-y-2 px-4 py-5 md:px-6 lg:grid-cols-[10rem_1fr_12rem_auto] lg:items-center lg:pr-[calc(1.5rem+var(--pill-gutter))]">
          <div class="flex items-baseline justify-between gap-4 lg:contents">
            <h4 class="display text-3xl">{tier.name}</h4>
            <p class="tabular text-right lg:order-3">
              <span class:list={['display block whitespace-nowrap', tier.price === null ? 'text-2xl' : 'text-3xl']}>{tier.price === null ? 'Sob consulta' : formatBRL(tier.price)}</span>
              {tier.priceNote && <span class="mt-1 block text-sm text-muted-foreground">{tier.priceNote}</span>}
            </p>
          </div>
          <p class="text-muted-foreground lg:order-2">{tier.description}</p>
          <div class="mt-2 lg:order-4 lg:mt-0">
            <ChatLink href={whatsappUrl(tier.whatsappMessage)} />
          </div>
        </li>
      ))
    }
  </ul>

  <h3 class="mt-16 text-xl font-bold">Pacotes</h3>
  <div class="mt-6 grid gap-4 md:grid-cols-2">
    {
      packs.map((pack) => (
        <div class:list={['relative flex flex-col rounded-[2px] bg-[#262626] p-6', pack.highlighted && 'outline-2 -outline-offset-2 outline-primary']}>
          {pack.highlighted && <p class="absolute top-3 right-4 text-xs font-semibold text-primary">Mais vantajoso</p>}
          <h4 class="display text-3xl">{`Pacote ${pack.name}`}</h4>
          <p class="mt-2 text-muted-foreground">{packContents(pack.items)}</p>
          <p class="display tabular mt-8 text-6xl">{formatBRL(pack.price)}</p>
          <p class="tabular mt-3">{formatBRL(packPricePerVideo(pack))} por vídeo</p>
          <p class="tabular">{packDiscountPercent(pack)}% de desconto</p>
          <p class="tabular text-muted-foreground"><s>{formatBRL(packFullPrice(pack))}</s></p>
          <p class="text-muted-foreground">Válido por {pack.validityDays} dias</p>
          <div class="mt-6">
            <ChatLink href={whatsappUrl(pack.whatsappMessage)} />
          </div>
        </div>
      ))
    }
  </div>

  <div class="mt-4 grid gap-x-8 gap-y-4 rounded-[2px] bg-[#232323] px-4 py-5 md:px-6 lg:grid-cols-[10rem_1fr_auto] lg:items-center lg:pr-[calc(1.5rem+var(--pill-gutter))]">
    <h4 class="display text-3xl">Contrato personalizado</h4>
    <p class="text-muted-foreground">{site.customContractText}</p>
    <div>
      <ChatLink href={whatsappUrl(customContractMessage)} />
    </div>
  </div>

  <p class="mt-8 flex items-center gap-2 text-sm text-foreground">
    <FileText size={18} strokeWidth={1.75} aria-hidden="true" className="shrink-0 text-muted-foreground" />
    {site.invoiceNote}
  </p>
</section>
