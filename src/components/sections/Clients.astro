---
import { Image } from 'astro:assets';
import { clients, people } from '@/data/clients';
import { site } from '@/data/site';

// Células vazias no fim da última linha, para a grade não ter buraco: quantas faltam muda com o número de colunas.
const missing = (cols: number) => (cols - (clients.length % cols)) % cols;
const [miss2, miss3, miss5] = [missing(2), missing(3), missing(5)];
const fillers = [1, 2, 3, 4];
---

<section id="trabalhou-com" class="page py-14 md:py-20" style="--accent: var(--yellow)">
  <p class="eyebrow">{site.clientsEyebrow}</p>
  <h2 class="display mt-2">Trabalhou com.</h2>
  <ul role="list" class="mt-10 grid grid-cols-2 gap-px border border-rule bg-rule sm:grid-cols-3 lg:grid-cols-5">
    {
      clients.map((client) => (
        <li class="flex h-22 items-center justify-center bg-background px-3 sm:h-28">
          <Image
            src={client.logo}
            alt={client.name}
            width={240}
            format="webp"
            loading="lazy"
            class:list={[
              'max-h-14 w-auto max-w-[min(11rem,100%)] object-contain',
              client.treatment === 'circle' && 'aspect-square h-14 w-14 rounded-full object-cover',
              client.treatment === 'brighten' && 'brightness-[1.8]',
            ]}
          />
        </li>
      ))
    }
    {
      fillers.map((n) => (
        <li
          aria-hidden="true"
          class:list={[
            'h-22 bg-background sm:h-28',
            n <= miss2 ? 'block' : 'hidden',
            n <= miss3 ? 'sm:block' : 'sm:hidden',
            n <= miss5 ? 'lg:block' : 'lg:hidden',
          ]}
        />
      ))
    }
  </ul>
  {
    people.length > 0 && (
      <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm text-foreground">
        {people.map((person) => (
          <li>
            <a href={person.url} target="_blank" rel="noopener" class="underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
              {person.handle}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</section>
