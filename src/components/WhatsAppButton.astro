---
import { whatsappUrl } from '@/lib/whatsapp';
---

<a
  href={whatsappUrl()}
  target="_blank"
  rel="noopener"
  aria-label="Conversar com o Vinicius no WhatsApp"
  class="fixed right-3 z-40 inline-flex min-h-11 items-center gap-2 rounded-full border border-[#3a3a3a] bg-[#262626] px-4 text-sm font-medium text-[#d4d4d4] transition-colors hover:bg-[#2e2e2e] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary md:right-6"
  style="bottom: calc(var(--timeline-h) + 12px + env(safe-area-inset-bottom, 0px));"
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M3 21l1.65-4.9A8.5 8.5 0 1 1 8 19.4L3 21z"></path>
    <path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1.2-1.4-1.9-1-.9.6a3.6 3.6 0 0 1-1.6-1.6l.6-.9-1-1.9L9 9.5z"></path>
  </svg>
  Conversar
</a>
