---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import Footer from '@/components/sections/Footer.astro';
import Clients from '@/components/sections/Clients.astro';
import Hire from '@/components/sections/Hire.astro';
import Process from '@/components/sections/Process.astro';
import Portfolio from '@/components/sections/Portfolio.astro';
import Timeline from '@/components/timeline/Timeline.tsx';
import { getImage } from 'astro:assets';
import { loadPortfolio } from '@/lib/drive';
import { site } from '@/data/site';
import { parseVideoName } from '@/lib/videoName';

// Se a busca falhar ou vier vazia, o build quebra de propósito: nunca publicar o portfólio vazio.
const videos = await loadPortfolio({
  apiKey: import.meta.env.GOOGLE_DRIVE_API_KEY,
  isDev: import.meta.env.DEV,
  folderId: site.driveFolderId,
});

// Pôster que não baixa não derruba o build: o vídeo só fica sem capa.
const posters = await Promise.all(
  videos.map(async (video) => {
    if (!video.posterUrl) return null;
    try {
      return (await getImage({ src: video.posterUrl, inferSize: true, width: 960, format: 'webp' })).src;
    } catch {
      return null;
    }
  }),
);

// Nome do arquivo no padrão `Título - Categoria - Detalhe`; fora do padrão, o nome inteiro vira o título.
const carouselVideos = videos.map((video, i) => ({
  n: i + 1,
  ...parseVideoName(video.title),
  embedUrl: video.embedUrl,
  poster: posters[i],
  aspectRatio: video.aspectRatio,
}));
---

<BaseLayout title={`${site.name} — ${site.role}`} description={site.heroText[0]}>
  <main>
    <Hero />
    <Portfolio videos={carouselVideos} />
    <Process />
    <Hire />
    <Clients />
  </main>
  <Footer />
  <Timeline slot="timeline" client:load videoCount={videos.length} />
</BaseLayout>
